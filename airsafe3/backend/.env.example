# Copy to .env (cargo run does not load it by itself: export the variables or use `set -a; . ./.env; set +a`)
PORT=8000
DATABASE_URL=postgres://airsafe:airsafe@localhost:5432/airsafe
# Long random string. Changing it logs everyone out.
AIRSAFE_SECRET_KEY=dev-only-change-me-before-real-use
# 0 = no simulated readings (only real/Wokwi devices)
SIM_ENABLED=1
# Serve the exported web app (web/out) from this process, like the original single-process build
# STATIC_DIR=../web/out

# Sign-In with Ethereum: must match the origin users see in the browser
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:8000
SIWE_CHAIN_ID=31337

# Ledger. Checkpoints are signed with this Ed25519 seed (64 hex chars); if unset, one is generated and kept in the DB.
# SERVER_SIGNING_KEY=
ANCHOR_INTERVAL_SECS=300
# On-chain anchoring (optional). Local dev chain: `anvil`, then deploy contracts/src/AirSafeAnchor.sol
# ANCHOR_RPC_URL=http://localhost:8545
# ANCHOR_CHAIN_ID=31337
# ANCHOR_CONTRACT=0x5FbDB2315678afecb367f032d93F642f64180aa3
# ANCHOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
